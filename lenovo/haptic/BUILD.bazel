load("//build/kernel/kleaf:kernel.bzl", "ddk_module", "ddk_headers")

package(default_visibility = ["//visibility:public"])

ddk_headers(
    name = "haptic_headers",
    hdrs = ["include/linux/lenovo_haptic.h"],
    includes = ["include"],
)

ddk_module(
    name = "canoe_perf_haptic",
    out = "haptic.ko",
    srcs = glob(["src/*.c", "src/*.h", "inc/*.h"]),
    kernel_build = "//vendor/lenovo/sm8850:canoe_perf_base_kernel",
    config = "//vendor/lenovo/sm8850:canoe_perf_config",
    includes = ['src'],
    local_defines = [],
    deps = [":haptic_headers", "//vendor/lenovo/sm8850:all_headers"],
)
