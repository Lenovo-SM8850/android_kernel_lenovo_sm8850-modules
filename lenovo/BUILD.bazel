load(":profiles.bzl", "BALDUR_MODULES", "COMMON_MODULES")
load("//build/kernel/kleaf:kernel.bzl", "kernel_module_group")
package(default_visibility = ["//visibility:public"])
kernel_module_group(
    name = "sm8850_common_modules",
    srcs = COMMON_MODULES,
)
kernel_module_group(
    name = "baldur_modules",
    srcs = COMMON_MODULES + BALDUR_MODULES,
)
alias(name = "canoe_perf_modules", actual = ":baldur_modules")
